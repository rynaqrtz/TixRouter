{
    "prettier.trailingComma": "none",
    "files.associations": {
        ".prettierignore": "ignore",
        ".dockerignore": "ignore",
        "*.jsonc": "jsonc"
    },
    "json.validate.enable": true,
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
}
