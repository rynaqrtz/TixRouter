{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@tixrouter/types": ["../../packages/types/src/index.ts"],
            "@tixrouter/constants": ["../../packages/constants/src/index.ts"]
        }
    },
    "include": ["src", "vite.config.ts"]
}
